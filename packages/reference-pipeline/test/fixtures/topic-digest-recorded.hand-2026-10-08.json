 "cards": {
  "releases": [
   {
    "text": "4.4.0 RC3 will be replaced by RC4 after David Jacot found a Maven signature problem.",
    "cites": [
     "KAFKA-MAIL-6c38f1a7"
    ]
   },
   {
    "text": "The 4.3.2 RC0 vote is still open; Jakub Scholz voted +1 (non-binding), and Bill Bejeck and Chia-Ping Tsai posted their verification steps.",
    "cites": [
     "KAFKA-MAIL-8849f679"
    ]
   },
   {
    "text": "Apache Kafka 4.2.2 was announced, and Andrew Schofield posted the 4.5.0 release plan with KIP freeze on 2027-01-13.",
    "cites": [
     "KAFKA-MAIL-d7907ec4",
     "KAFKA-MAIL-6f627126"
    ]
   }
  ],
  "group-coordination": [
   {
    "text": "KAFKA-20292 merged parts 9–13 of assignor offloading; the open part 14 would run the consumer-group assignor on a coordinator background thread, with the new config defaulting to true.",
    "cites": [
     "KAFKA-PR-23622",
     "KAFKA-PR-23623",
     "KAFKA-PR-23624",
     "KAFKA-PR-23666",
     "KAFKA-PR-23667",
     "KAFKA-PR-23688"
    ]
   },
   {
    "text": "David Jacot opened three PRs for a uniform2 consumer assignor (KAFKA-21214) and proposed KIP-1379.",
    "cites": [
     "KAFKA-PR-23722",
     "KAFKA-PR-23723",
     "KAFKA-PR-23724",
     "KAFKA-MAIL-7eb8eba3"
    ]
   },
   {
    "text": "Two open PRs address members that stall when closing with REMAIN_IN_GROUP after a poll timeout, one for the Streams group protocol and one for the consumer group protocol.",
    "cites": [
     "KAFKA-PR-23712",
     "KAFKA-PR-23714"
    ]
   }
  ],
  "clients": [
   {
    "text": "The KIP-1306 author asked on dev@ for reviews of six PRs; Andrew Schofield said he will review them and noted many PRs are waiting.",
    "cites": [
     "KAFKA-MAIL-f09ac41a",
     "KAFKA-PR-23105",
     "KAFKA-PR-23115"
    ]
   },
   {
    "text": "KIP-1368 added `client.framework.id`, and on 10-05 Chris Egerton questioned using the instance ID to report connector type and version.",
    "cites": [
     "KAFKA-MAIL-fd63cd54"
    ]
   },
   {
    "text": "Lianet Magrans asked for care on an open async-consumer fetch-buffer PR because recent busy-loop fixes touch the same path.",
    "cites": [
     "KAFKA-PR-21991"
    ]
   }
  ],
  "share-groups": [
   {
    "text": "KIP-1349 received a +1 (binding) and a +1 this week, and Chia-Ping Tsai asked whether a bytes-based trigger is better than a count.",
    "cites": [
     "KAFKA-MAIL-82e0d5b3",
     "KAFKA-MAIL-4bc41094"
    ]
   },
   {
    "text": "A draft PR for KIP-1289 would let share-group acknowledgements join a producer transaction.",
    "cites": [
     "KAFKA-PR-22357"
    ]
   },
   {
    "text": "An open PR would keep the original headers in share-group DLQ records.",
    "cites": [
     "KAFKA-PR-23659"
    ]
   }
  ],
  "security": [
   {
    "text": "On the snappy-java CVE thread, Martin Andersson said lz4-java is the problem; the merged lz4-java 1.11.4 bump fixes three advisories, and a 1.12.0 bump is open.",
    "cites": [
     "KAFKA-MAIL-e0d9d8c1",
     "KAFKA-PR-23609",
     "KAFKA-PR-23637"
    ]
   },
   {
    "text": "An open PR adds a broker config to reject client writes that use chosen compression types.",
    "cites": [
     "KAFKA-PR-23698"
    ]
   },
   {
    "text": "KIP-1376 (TLS named groups) and KIP-1342 (deprecate `Authorizer#aclCount`) are under discussion.",
    "cites": [
     "KAFKA-MAIL-3bc971ac",
     "KAFKA-MAIL-3bff04e6"
    ]
   }
  ],
  "storage": [
   {
    "text": "A dev@ question about KIP-1023 led to KAFKA-21190 and an open PR that skips the remote aux-state rebuild when the fetch offset equals the log start offset.",
    "cites": [
     "KAFKA-MAIL-61bf4c33",
     "KAFKA-PR-23650"
    ]
   },
   {
    "text": "A reviewer said per-client-id remote fetch metrics need a KIP, and the author agreed to write one.",
    "cites": [
     "KAFKA-PR-23463"
    ]
   },
   {
    "text": "KIP-1165 was reopened with a fuller object-consolidation design.",
    "cites": [
     "KAFKA-MAIL-f93938c0",
     "KAFKA-MAIL-a9696e08"
    ]
   }
  ],
  "streams": [
   {
    "text": "An open PR adds rack-aware standby task assignment (KAFKA-20999) with fuzz-testbed and JMH results.",
    "cites": [
     "KAFKA-PR-23588"
    ]
   },
   {
    "text": "The KAFKA-20224 iterator-adapter refactor was merged.",
    "cites": [
     "KAFKA-PR-21830"
    ]
   }
  ],
  "community": [
   {
    "text": "Sushant Mahajan became a committer.",
    "cites": [
     "KAFKA-MAIL-85a6bd91"
    ]
   },
   {
    "text": "Cruise Control moved to the Linux Foundation.",
    "cites": [
     "KAFKA-MAIL-55bead25"
    ]
   },
   {
    "text": "Contributors asked committers to approve CI runs, and two newcomers asked about pending Jira accounts.",
    "cites": [
     "KAFKA-MAIL-b6d05376",
     "KAFKA-MAIL-b7e5a84f",
     "KAFKA-MAIL-2dc19c3f",
     "KAFKA-MAIL-750d8124"
    ]
   }
  ]
 },
 "proposals": {
  "KIP-1349": {
   "text": "Andrew Schofield voted +1 (binding) on 10-01 and Sushant Mahajan voted +1 on 10-05; Chia-Ping Tsai asked on 10-06 whether bytes beat a count.",
   "cites": [
    "KAFKA-MAIL-82e0d5b3",
    "KAFKA-MAIL-4bc41094"
   ]
  },
  "KIP-1368": {
   "text": "On 10-05 Andrew Schofield added a third config, `client.framework.id`, after Lianet Magrans' feedback.",
   "cites": [
    "KAFKA-MAIL-fd63cd54"
   ]
  },
  "KIP-1379": {
   "text": "Proposed by David Jacot on 10-02; Lucas Brutschy asked about upgrade and downgrade on 10-05.",
