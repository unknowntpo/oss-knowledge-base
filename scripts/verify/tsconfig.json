{
  // Typechecks the verification CLI and the Access-token fixtures and harness (bun run typecheck). Node types come from
  // the web app's install; Playwright types from the repository root.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["*.ts", "../../apps/web/deployed-e2e/*.ts", "../../apps/web/access-e2e/*.ts", "../../playwright.*.ts"]
}
