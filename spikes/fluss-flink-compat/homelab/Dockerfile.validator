FROM oven/bun:1.3.13 AS bun

FROM maven:3.9.9-eclipse-temurin-17

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /workspace
COPY . .

RUN mkdir -p node_modules/@oss-knowledge-base \
    && ln -s /workspace/packages/domain node_modules/@oss-knowledge-base/domain \
    && ln -s /workspace/packages/serving-contract node_modules/@oss-knowledge-base/serving-contract
RUN mvn -B -f spikes/fluss-flink-compat/pom.xml -DskipTests test-compile

ENTRYPOINT ["bun", "spikes/fluss-flink-compat/homelab/validate.ts"]
