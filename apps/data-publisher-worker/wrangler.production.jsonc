{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oss-knowledge-base-data-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "vars": {
    "PUBLICATION_ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": ["37 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "OSS_KB_BUCKET",
      "bucket_name": "oss-knowledge-base-prod"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PIPELINE_STATE",
        "class_name": "PipelineState"
      },
      {
        "name": "DIGEST_RUN",
        "class_name": "DigestRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PipelineState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DigestRun"]
    }
  ]
}
