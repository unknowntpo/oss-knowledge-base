{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oss-knowledge-base-data-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLICATION_ENVIRONMENT": "development",
    "SEARCH_LEXICAL_REVISION": "bm25-reference@3",
    "DIGEST_ENABLED": "true",
    "DIGEST_MODEL": "workers-ai",
    "DIGEST_GATEWAY_ID": "osskb-digest-dev",
    "DIGEST_CRON": "47 22 * * *",
    "SEARCH_GATEWAY_ID": "osskb-search-dev",
    "SEARCH_EMBEDDING": "bge-m3@1",
    "SEARCH_SHARD_ROOTS": "true",
    "GITHUB_REVIEWS": "metadata@2",
    "PEOPLE_ACTIVITY": "log@1",
    "COST_GUARD": "monitor",
    "CF_ACCOUNT_ID": "2ef5fb1cf4a7bfd3de423dd10c2b2191",
    "IDENTITY_LINKS": "corroborated@1",
    "IDENTITY_LINKS_CRON": "17 2 * * *",
    "KIP_PAGES": "authors@1",
    "KIP_PAGES_CRON": "43 3 * * *",
    "OBSERVABILITY_SIGNALS": "on",
    "SRE_AGENT": "off",
    "SRE_AGENT_CRON": "30 0 * * *;0 11 * * *",
    "SRE_AGENT_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    {
      "binding": "SIGNALS",
      "dataset": "osskb_signals_dev"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "vectorize": [
    {
      "binding": "SEARCH_VECTORS",
      "index_name": "osskb-search-dev"
    }
  ],
  "triggers": {
    "crons": ["7 22 * * *", "47 22 * * *", "17 2 * * *", "43 3 * * *", "30 0 * * *", "0 11 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "OSS_KB_BUCKET",
      "bucket_name": "oss-knowledge-base-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PIPELINE_STATE",
        "class_name": "PipelineState"
      },
      {
        "name": "DIGEST_RUN",
        "class_name": "DigestRun"
      },
      {
        "name": "SEARCH_EMBEDDING_RUN",
        "class_name": "SearchEmbeddingRun"
      },
      {
        "name": "SEARCH_QUERY_GATE",
        "class_name": "SearchQueryGate"
      },
      {
        "name": "COST_GUARD_STATE",
        "class_name": "CostGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PipelineState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DigestRun"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SearchEmbeddingRun"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["SearchQueryGate"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["CostGuard"]
    }
  ]
}
